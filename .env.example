# Copy to .env and fill in. Never commit .env.
# Telegram Serverless CLI token (@BotFather → your bot → Serverless → CLI Access)
TGCLOUD_TOKEN=app123456789:xxxxxxxx
# Telegram bot token (only used by scripts/set-commands.sh)
TG_BOT_TOKEN=123456789:xxxxxxxx
# Bale bot token (deployed via the generated lib/secrets.js)
BALE_BOT_TOKEN=123456789:xxxxxxxx
